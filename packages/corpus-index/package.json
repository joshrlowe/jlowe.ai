{
  "name": "@velocity/corpus-index",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "index": "tsc -p tsconfig.json && node dist/cli.js write",
    "index:check": "tsc -p tsconfig.json && node dist/cli.js check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^15.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "~5.9.0",
    "vitest": "^4.1.0"
  }
}
