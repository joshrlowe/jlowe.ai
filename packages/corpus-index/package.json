{
  "name": "@velocity/corpus-index",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "index": "tsc -p tsconfig.json && node dist/cli.js write",
    "index:check": "tsc -p tsconfig.json && node dist/cli.js check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "eval:live": "RUN_LIVE_EVAL=1 vitest run src/golden/live.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1068.0",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "~5.9.0",
    "vitest": "^4.1.0"
  }
}
