# Database
# Local dev: `docker compose up -d --wait` serves this URL (see README).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/jlowe_dev
PRISMA_DATABASE_URL=
PRISMA_LOG_QUERIES=false

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
ADMIN_EMAIL=
# MUST differ from NEXTAUTH_SECRET. Do not reuse the NextAuth secret as the
# admin login password — they are separate credentials.
ADMIN_PASSWORD=
OWNER_EMAIL=

# AWS / Bedrock
# Vercel (preview + production): set AWS_ROLE_ARN only; functions exchange
# their Vercel OIDC token for that role. Local dev: leave it empty and set
# AWS_PROFILE (a profile from ~/.aws) or a key pair instead.
AWS_REGION=us-east-1
AWS_ROLE_ARN=
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Upstash (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Observability
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cal.com integration
CALCOM_USERNAME=
CALCOM_EVENT_TYPE_SLUG=

# Cron auth
CRON_SECRET=

# Legacy (delete if MongoDB → Prisma migration is complete)
MONGODB_URI=
MONGODB_URL=

# Optional / search
COHERE_API_KEY=
SKIP_VISUAL_TESTS=

# Platform-injected — do not set these manually.
# NODE_ENV is set by Next.js (development/production/test) and VERCEL_URL is
# injected by Vercel per deployment; lib/config.ts reads both. Overriding them
# in .env breaks dev-mode detection and preview URL resolution.
