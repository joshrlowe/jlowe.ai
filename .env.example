# Velocity (v2) environment template.
# Copy to .env for local extras. Placeholder values only — never commit real
# secrets. `pnpm dev` runs the static site with every value below empty.
#
# Chat, contact, and Langfuse run in AWS. Terraform injects the Lambda
# environment (infra/terraform/modules/chat and modules/contact). Do not put
# Bedrock, SES, or Langfuse secrets in the Next.js bundle.

# --- apps/web (build time) -------------------------------------------------
# Canonical origin for metadata, sitemap, and robots. Empty falls back to
# https://jlowe.ai (apps/web/src/lib/site-config.ts). Deploy sets this from
# the GitHub Actions variable SITE_URL.
NEXT_PUBLIC_SITE_URL=

# Optional. Fine-grained or classic PAT with public read, used at `next build`
# to bake the GitHub contribution grid. Absent → seeded placeholder, build
# still succeeds (apps/web/src/lib/github/contributions.ts).
GITHUB_TOKEN=

# --- services/chat (Lambda env, owned by Terraform) ------------------------
# Public inference-profile id already used as the code default. Not a secret.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# DynamoDB table name. Empty → in-memory store (tests / local handler).
CHAT_SESSIONS_TABLE=
# Cal.com booking link. Empty username keeps book_meeting off (fail closed).
CALCOM_USERNAME=
CALCOM_EVENT_TYPE_SLUG=30min
# SSM parameter *names*, not the Langfuse keys. Terraform creates
# /jlowe-ai/<env>/langfuse/public-key and .../secret-key. Initial Terraform
# value is the literal "unset", which the SDK treats as off. Put real keys in
# SSM after apply; do not commit them here.
LANGFUSE_PUBLIC_KEY_PARAM=
LANGFUSE_SECRET_KEY_PARAM=
# Optional override. Code default is https://cloud.langfuse.com.
LANGFUSE_HOST=https://cloud.langfuse.com

# --- services/chat digest Lambda -------------------------------------------
DIGEST_FROM_ADDRESS=
DIGEST_TO_ADDRESS=

# --- services/contact (Lambda env, owned by Terraform) ---------------------
# From address is <local-part>@<domain> (default local-part "contact").
CONTACT_FROM_ADDRESS=
CONTACT_TO_ADDRESS=

# --- live evals (developer machine or the nightly OIDC role) ---------------
# Set to 1 to run `pnpm --filter @velocity/chat eval:live` and the corpus-index
# live probe. Uses the AWS SDK default credential chain (AWS_PROFILE / role),
# not static access keys.
RUN_LIVE_EVAL=
AWS_REGION=us-east-1
AWS_PROFILE=

# --- present on main's v1 .env.example, unused by this tree ----------------
# DATABASE_URL, PRISMA_DATABASE_URL, NEXTAUTH_URL, NEXTAUTH_SECRET,
# ADMIN_EMAIL, ADMIN_PASSWORD, OWNER_EMAIL, UPSTASH_REDIS_REST_URL,
# UPSTASH_REDIS_REST_TOKEN, INNGEST_EVENT_KEY, INNGEST_SIGNING_KEY,
# RESEND_API_KEY, RESEND_FROM_EMAIL, CRON_SECRET, MONGODB_URI, MONGODB_URL,
# COHERE_API_KEY, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY.
# Those belong to the v1 app on `main`. Leave them unset here.
