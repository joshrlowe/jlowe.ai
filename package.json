{
  "name": "jlowe.ai",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:nocheck": "! grep -rln '@ts-nocheck' --include='*.ts' --include='*.tsx' components/ pages/ lib/ middleware.ts 2>/dev/null || (echo 'Found @ts-nocheck in source files'; exit 1)",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:test-connection": "node scripts/test-prisma-connection.js",
    "prisma:migrate-data": "node scripts/migrate-data.js",
    "prisma:migrate-resources-to-posts": "node scripts/migrate-resources-to-posts.js",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:content": "node scripts/seed-content.js",
    "seed:all": "npm run seed:admin && npm run seed:content",
    "build:embeddings": "tsx scripts/regenerate-embeddings.ts",
    "build:embeddings:legacy": "tsx scripts/generate-embeddings.ts",
    "jobs:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1106.0",
    "@prisma/client": "^5.20.0",
    "@react-three/fiber": "^8.18.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.7.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "gsap": "^3.14.2",
    "inngest": "^4.18.0",
    "langfuse": "^3.38.20",
    "marked": "^15.0.12",
    "next": "^15.5.23",
    "next-auth": "^4.24.15",
    "prisma": "^5.20.0",
    "react": "^18",
    "react-dom": "^18",
    "react-github-calendar": "^5.0.8",
    "react-markdown": "^10.1.0",
    "react-toastify": "^11.1.0",
    "react-typed": "^2.0.12",
    "remark-gfm": "^4.0.0",
    "resend": "^6.18.1",
    "slugify": "^1.6.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest": "^30.0.0",
    "@types/three": "^0.185.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "globals": "^17.9.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "msw": "^2.15.0",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.11",
    "typescript": "^5.9.0",
    "undici": "^7.24.0"
  },
  "overrides": {
    "fast-xml-parser": "^5.8.0",
    "undici": "^7.24.0",
    "@opentelemetry/otlp-transformer": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "minimatch": "^9.0.7",
    "test-exclude": {
      "minimatch": "^3.1.2"
    },
    "picomatch": "^2.3.2",
    "preact": "^10.29.1",
    "brace-expansion": "^2.0.3",
    "flatted": "^3.4.2",
    "ajv": "^6.14.0"
  }
}
