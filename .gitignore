# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

.env

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# playwright
/test-results/
/playwright-report/
/playwright/.cache/

# next.js
/.next/
/out/

# next-sitemap output (regenerated by postbuild)
/public/sitemap.xml
/public/sitemap-0.xml
/public/robots.txt

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploads
/public/uploads

# test artifacts (temporary files)
test-upstash.ts

# generated knowledge base (optional - remove if you want to commit)
/data/

# personal planning docs (do not commit)
FUTURE_PLANS.md
/docs/planning/

# verification / audit run artifacts (ephemeral)
/verification-*/
/.audit-baseline/
/.audit-post-phase1/
/.audit-final/

# lighthouse ci output
/.lighthouseci/

# terraform — state can contain secrets; never commit it
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
